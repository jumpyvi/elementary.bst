#!/usr/bin/env bash
set -euo pipefail


# Fix suid

chmod u+s /usr/bin/fusermount3

chmod 4755 /usr/bin/sudo /usr/bin/su /usr/bin/passwd /usr/bin/newuidmap /usr/bin/newgidmap


# Remove empty gnome session
rm -f /usr/share/wayland-sessions/gnome.desktop


# Add repo/objects for flatpaks

mkdir -p /etc/skel/.local/share/flatpak/repo/objects/